  <ItemGroup>
    <!-- Logging *contracts* only (ILogger<T>). No implementation, no EF, no ASP.NET:
         the composition root decides where log output actually goes. Without this the
         Application layer cannot report a failure at all, which is why a 503 used to
         reach the client with nothing on the server side to explain it. -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.10" />
