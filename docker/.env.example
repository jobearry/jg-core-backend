ASPNETCORE_ENVIRONMENT=Development
Notion__Version=2026-03-11
Notion__Token=notion_token
Jwt__Key=jwt_key
Jwt__Issuer=jdb_api
Jwt__Audience=PortfolioApiUsers
Jwt__ExpirationInMinutes=60
Github__Token=ghp_yourtokensample
Github__BaseUrl=https://api.github.com

# Database -----------------------------------------------------------------
# Required. The compose stack runs the API only; PostgreSQL is external.
# Supply the full Npgsql connection string.
#
# `host.docker.internal` reaches a PostgreSQL running on your machine
# (docker-compose.yml maps that name on Linux as well as Docker Desktop).
# For a hosted database, use its host and add the SSL settings it requires.
ConnectionStrings__JDBConnection=Host=host.docker.internal;Port=5432;Database=jg-portfolio;Username=postgres;Password=postgres;Ssl Mode=Disable

# API ----------------------------------------------------------------------
# Host port mapped to the API container (container always listens on 8080).
API_PORT=5254
