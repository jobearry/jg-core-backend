ASPNETCORE_ENVIRONMENT=Development
Notion__Version=2026-03-11
Notion__Token=notion_token
Jwt__Key=jwt_key
Jwt__Issuer=jdb_api
Jwt__Expires=60
Jwt__Audience=PortfolioApiUsers
ConnectionStrings__JDBConnection=your_db

# PostgreSQL ---------------------------------------------------------------
# Used both to initialise the container and to build the API connection string.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=jdb_portfolio

# Host port exposed for PostgreSQL (5432 is the default). Useful when you
# already have a local Postgres running on that port.
POSTGRES_PORT=5454

# API ----------------------------------------------------------------------
# Host port mapped to the API container (container always listens on 8080).
API_PORT=5254