# ---------------------------------------------------------------------------
# Shared configuration
# ---------------------------------------------------------------------------
# JWT signing key - must be at least 32 bytes (256 bits) for HmacSha256
Jwt__Key=replace-with-a-32-plus-character-secret-key
Jwt__Issuer=Jwt__Issuer
Jwt__Audience=Jwt__Audience

DOTNET_ENVIRONMENT=Development

# ---------------------------------------------------------------------------
# JGBackend (auth + health)
# ---------------------------------------------------------------------------
Jwt__Expires=60

# ---------------------------------------------------------------------------
# Portfolio API
# ---------------------------------------------------------------------------
# Portfolio still reads its token lifetime from Jwt__ExpirationInMinutes until
# the auth systems are unified on Jwt__Expires in the single-host refactor.
Jwt__ExpirationInMinutes=60

ASPNETCORE_ENVIRONMENT=Development
API_PORT=5254

Notion__Version=2026-03-11
Notion__Token=notion_token

Github__Token=ghp_yourtokensample
Github__BaseUrl=https://api.github.com

# Required. Full Npgsql connection string for the PostgreSQL database.
# `host.docker.internal` reaches a PostgreSQL running on your machine.
ConnectionStrings__JDBConnection=Host=host.docker.internal;Port=5432;Database=jg-portfolio;Username=postgres;Password=postgres;Ssl Mode=Disable
